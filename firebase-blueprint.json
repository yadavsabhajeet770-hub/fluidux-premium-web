{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, prediction statistics and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "stats": {
          "type": "object",
          "description": "Game statistics (total, wins, loss)"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Private user profile and statistics"
    }
  }
}
